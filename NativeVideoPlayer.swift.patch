+
+private final class PreviewPresentationLayer: NSView {
+    private let playerView = AVPlayerView()
+    
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        setUpPlayerView()
+    }
+    
+    required init?(coder: NSCoder) {
+        super.init(coder: coder)
+        setUpPlayerView()
+    }
+    
+    private func setUpPlayerView() {
+        wantsLayer = true
+        layer?.masksToBounds = false
+        
+        playerView.controlsStyle = .none
+        playerView.videoGravity = .resizeAspect
+        
+        addSubview(playerView)
+    }
+    
+    override func layout() {
+        super.layout()
+        playerView.frame = bounds
+    }
+    
+    func update(player: AVPlayer, transform: ClipTransform) {
+        if playerView.player !== player {
+            playerView.player = player
+        }
+        
+        let scale = transform.scale
+        let rotation = CGFloat(transform.rotation) * .pi / 180.0
+        
+        var t = CATransform3DIdentity
+        t = CATransform3DTranslate(t, CGFloat(transform.positionX), -CGFloat(transform.positionY), 0)
+        t = CATransform3DScale(t, scale, scale, 1)
+        t = CATransform3DRotate(t, rotation, 0, 0, 1)
+        
+        playerView.wantsLayer = true
+        playerView.layer?.transform = t
+    }
+}
